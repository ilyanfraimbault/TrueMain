{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrueMain",
  "version": "0.1.0",
  "identifier": "gg.truemain.desktop",
  "build": {
    "frontendDist": "../app/.output/public",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "npm run dev --prefix ../app",
    "beforeBuildCommand": "npm run generate --prefix ../app"
  },
  "app": {
    "windows": [
      {
        "title": "TrueMain",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org data:; connect-src 'self' https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
