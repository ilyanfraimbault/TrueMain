{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrueMain",
  "version": "0.2.1",
  "identifier": "gg.truemain.desktop",
  "build": {
    "frontendDist": "../app/.output/public",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "npm run dev --prefix ../app",
    "beforeBuildCommand": "npm run generate --prefix ../app"
  },
  "app": {
    "windows": [
      {
        "title": "TrueMain",
        "width": 1180,
        "height": 760,
        "resizable": false,
        "maximizable": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "files": {
        "MacOS/truemain-capture": "binaries/truemain-capture"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNURERDZERDdBRjc1QzMKUldURGRhL1hiZDFkeXp0S3BtL2FNVmQ5ZUdRaTFYR2R3bGR2NU5aM09Fb0d4b2UxaG44dHJGeEUK",
      "endpoints": [
        "https://truemain.lol/api/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
