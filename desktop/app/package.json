{
  "name": "truemain-desktop-app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 3003",
    "generate": "nuxt generate",
    "build": "nuxt generate",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "cd .. && node --env-file-if-exists=.env.local app/node_modules/@tauri-apps/cli/tauri.js",
    "tauri:sim": "TRUEMAIN_LCU_SIM=http://localhost:3003/__sim/lcu npm run tauri -- dev"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.3.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/eslint": "^1.17.0",
    "@tauri-apps/cli": "~2.12.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
