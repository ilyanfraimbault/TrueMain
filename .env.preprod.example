POSTGRES_USER=truemain_preprod
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=truemain_preprod
# MongoDB credentials (logs + audit + Riot usage rollups). Keep them
# ALPHANUMERIC — they are embedded in the connection URI.
MONGO_USER=truemain_preprod
MONGO_PASSWORD=REPLACE_ME
# Preprod uses its OWN Riot API key — never the production one. PUUIDs are
# encrypted per API app, so the key and the database form an inseparable pair:
# a fresh key requires a fresh database (and vice versa).
RIOT_API_KEY=RGAPI-REPLACE_ME_PREPROD
OPS_API_KEY=REPLACE_WITH_RANDOM_32+_CHAR_SECRET
# Optional: at least 32 characters when set (e.g. `openssl rand -hex 24`). The key
# the web and admin servers present to the API's POST /internal/logs to report
# their own errors to the ops logs; distinct from OPS_API_KEY. Empty turns error
# forwarding off without affecting anything else.
LOG_INGEST_KEY=
NUXT_API_BASE_URL=http://api:8080
# Browser-reachable origins of the public site and the admin portal, served by
# the edge Caddy, e.g. http://<vps-ip>:3001 and http://<vps-ip>:3002. Kept in
# .env so the VPS address stays out of the repo. The site origin is what the
# web app advertises in canonical links, the sitemap and robots.txt; the API
# allows both as CORS origins. Required: the deploy fails without them.
PREPROD_SITE_URL=
PREPROD_ADMIN_URL=

# Admin dashboard (admin/). Preprod is a non-dev environment, so the app
# refuses to boot with the insecure `truemain` defaults: generate real values
# before deploying (e.g. `openssl rand -hex 32` for the session secret, which
# must be >= 32 chars). Placeholders below force an operator to fill them in.
ADMIN_SESSION_PASSWORD=REPLACE_WITH_RANDOM_32+_CHAR_SECRET
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Umami analytics (self-hosted, #742) -------------------------------------
# Umami runs fully separate from the TrueMain backend (own Postgres) and is
# published on host port 3100 through the umami-proxy Caddy (no DNS/TLS in
# preprod). First login: admin / umami — change it immediately.
# Keep the password ALPHANUMERIC (e.g. `openssl rand -hex 24`) — it is
# embedded raw in Umami's DATABASE_URL, so URI-reserved chars (@ : / + = ? %)
# corrupt the parsed password and crash-loop Umami with 28P01 auth failures.
# The deploy workflow overwrites the VPS .env from the PREPROD_ENV_FILE
# GitHub secret on every run — change the password there, not on the VPS.
UMAMI_DB_PASSWORD=REPLACE_ME
# Signs Umami sessions and tokens. Generate a random 32+ char secret.
UMAMI_APP_SECRET=REPLACE_WITH_RANDOM_32+_CHAR_SECRET
# Browser-reachable URL of the umami-proxy, e.g. http://<vps-ip>:3100. Kept in
# .env so the VPS address stays out of the repo. Tracker + admin embed stay
# disabled while empty.
UMAMI_PUBLIC_URL=
# Admin portal origin allowed to iframe the dashboard, e.g. http://<vps-ip>:3002.
UMAMI_ALLOWED_FRAME_ORIGIN=
# Website id created in the Umami UI (Settings -> Websites -> Add website).
UMAMI_WEBSITE_ID=
# Public share URL of the website dashboard (website settings -> Share URL).
UMAMI_SHARE_URL=
