# TrueMain — reverse proxy with automatic HTTPS (Caddy).
#
# Caddy listens on 80/443, obtains and AUTO-RENEWS a Let's Encrypt certificate
# for every site address below, and proxies to the app containers over the
# internal compose network. Certificates and the ACME account live in the
# `caddy_data` volume so they survive restarts (re-issuing on every boot would
# hit Let's Encrypt rate limits).
#
# Requirements on the host:
#   - ports 80 AND 443 open to the internet (HTTP-01 / TLS-ALPN-01 challenges)
#   - DNS A records: truemain.lol, www.truemain.lol, admin.truemain.lol,
#     analytics.truemain.lol -> VPS IP
#
# This file must sit next to compose.prod.yaml on the server (it is bind-mounted
# read-only into the caddy container).
#
# Access logs: Caddy writes NO access log unless a site block asks for one, so
# `log` is opted into per site below. Output goes to stderr, which Docker's
# json-file driver already caps at 3 x 10 MB per container (daemon.json), so the
# logs cannot fill the disk and `docker logs truemain-caddy` shows them. That
# budget is shared, which is why only the two sites worth auditing enable it:
# the public site (bot crawls, 404s, upstream errors) and the admin portal
# (authentication attempts). The analytics vhost is deliberately left out — the
# Umami tracker fires on every page view and would evict everything else.

# Security response headers shared by the two app-owned vhosts (the public site
# and the admin portal). NOT imported into the analytics vhost: Umami ships its
# own CSP there and an X-Frame-Options here would fight the admin Analytics
# iframe the analytics block deliberately allows. Each vhost adds its own
# Content-Security-Policy after the import because the allowed origins differ
# (the public site loads the Umami tracker; the admin embeds the Umami
# dashboard). See docs/ci.md.
(security_headers) {
	header {
		# Pin HTTPS for a year, subdomains included: every TrueMain host is HTTPS
		# through this edge, so a downgrade is always an attack.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# No MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Belt-and-braces clickjacking defence for user agents that predate
		# CSP frame-ancestors (which each vhost also sets).
		X-Frame-Options "DENY"
		# Leak only the origin cross-site, nothing at all on an HTTPS->HTTP step.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Switch off powerful features the app never asks for.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		# Don't advertise the framework.
		-X-Powered-By
	}
}

# Public site
truemain.lol {
	log
	encode zstd gzip
	import security_headers
	# Public site CSP. 'unsafe-inline' is required for Nuxt's hydration
	# scripts and the charts' inline styles (no nonce pipeline); scripts and
	# the analytics beacon are pinned to the Umami host, images to the two
	# game-asset CDNs (most arrive same-origin via /_ipx, some directly).
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://ddragon.leagueoflegends.com https://raw.communitydragon.org; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://analytics.truemain.lol; connect-src 'self' https://analytics.truemain.lol; worker-src 'self' blob:; frame-src 'self'"
	reverse_proxy web:3000
}

# Canonical host: send www -> apex
www.truemain.lol {
	redir https://truemain.lol{uri} permanent
}

# Admin dashboard
admin.truemain.lol {
	log
	encode zstd gzip
	import security_headers
	# Admin CSP: same base as the public site, but it embeds the Umami
	# dashboard in an iframe (Analytics tab) rather than loading the tracker,
	# so analytics is allowed under frame-src, not script/connect-src.
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://ddragon.leagueoflegends.com https://raw.communitydragon.org; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; frame-src https://analytics.truemain.lol"

	# Force X-Forwarded-For to the real peer IP, dropping any client-supplied
	# value. Caddy already does this by default (the browser is an untrusted
	# peer), but setting it explicitly documents the invariant the admin's
	# per-IP login throttle relies on (it trusts XFF only when NUXT_TRUST_PROXY
	# is set, i.e. here in prod) and keeps it robust across Caddy versions. The
	# admin container is not published on the host — only Caddy reaches it.
	reverse_proxy admin:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Self-hosted Umami analytics (#728): serves the tracker script loaded by
# truemain.lol pages and the dashboard embedded by the admin Analytics tab.
analytics.truemain.lol {
	reverse_proxy umami:3000 {
		# Umami bakes `frame-ancestors 'self'` into its CSP at image build
		# time (ALLOWED_FRAME_URLS only applies to source builds), which
		# blocks the admin portal's Analytics iframe. Rewrite the directive
		# on the way out to also allow the admin origin.
		header_down Content-Security-Policy "frame-ancestors 'self'" "frame-ancestors 'self' https://admin.truemain.lol"
	}
}
