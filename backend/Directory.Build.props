<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Pinned rather than left to the SDK default: an SDK bump would otherwise
         change language semantics silently. Raise this deliberately, in its own
         commit, so the switch is reviewable. Matches net10.0's own default today. -->
    <LangVersion>14.0</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML doc on a public member) is suppressed for production code
      by deliberate decision, not by accident — see #297. Measured on 2026-07-28:
      Core 332, Data 1596, Api 1248, Ingestor 894 occurrences. Enforcing it would
      mean thousands of doc comments, overwhelmingly on record properties and entity
      columns where the generated text would restate the member name and add nothing.
      The types that carry real design rationale (DedicationScore, MainDedication,
      the aggregation components) are already documented by hand, which is where the
      value is.

      Test projects no longer depend on this suppression at all: they set
      GenerateDocumentationFile=false (#291), so CS1591 cannot fire there. Generated
      code (EF migrations, compiled models) is scoped in .editorconfig.
    -->
    <NoWarn>$(NoWarn);IDE0058;CS1591</NoWarn>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GHSA-37gx-xxp4-5rgx (CVE-2026-33116, High/7.5): DoS via an infinite loop in
      System.Security.Cryptography.Xml's EncryptedXml class. The package is only
      pulled in transitively and EncryptedXml is not used by this codebase, so the
      vulnerable code path is unreachable. Suppressed pending a transitive upgrade
      to a patched release (>= 10.0.6). Last reviewed: 2026-05-29.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <!--
      GHSA-w3x6-4m5h-cxqf (CVE-2026-26171, High/7.5): DoS via uncontrolled resource
      consumption in System.Security.Cryptography.Xml's EncryptedXml class. Same
      transitive package as above; EncryptedXml is not used by this codebase, so the
      vulnerable code path is unreachable. Suppressed pending a transitive upgrade
      to a patched release (>= 10.0.6). Last reviewed: 2026-05-29.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
  </ItemGroup>
</Project>
