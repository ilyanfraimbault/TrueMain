{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Mongo": {
      "LogLevel": {
        "Polly": "Error"
      }
    }
  },
  "MongoLogging": {
    "Database": "truemain_logs",
    "LogsCollection": "logs",
    "AuditCollection": "audit_events",
    "RiotApiCallsCollection": "riot_api_call_rollups",
    "Enabled": true,
    "MinimumLevel": "Warning",
    "LogsRetention": "90.00:00:00",
    "RiotApiCallsRetention": "14.00:00:00",
    "CrashesCollection": "crashes",
    "CrashesRetention": "365.00:00:00",
    "CrashFilePath": "/home/app/crashes",
    "CrashFileMaxBytes": 5000000,
    "CrashLogTailSize": 200,
    "CrashMongoWriteTimeout": "00:00:03"
  },
  "Riot": {
  },
  "CommunityDragon": {
  },
  "Job": {
  },
  "Platforms": {
    "Active": [ "KR", "EUW1", "NA1" ]
  },
  "LadderSync": {
    "TierScope": [ "Challenger", "GM", "Master", "Diamond", "Emerald" ]
  },
  "Discovery": {
    "TierScope": [ "Master", "GM", "Challenger" ],
    "MinRunInterval": "1.00:00:00"
  },
  "MainAnalysis": {
    "BatchSize": 1000,
    "ProcessingBatchSize": 50
  }
}
